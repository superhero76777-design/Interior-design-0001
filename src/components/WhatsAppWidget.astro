---
/**
 * Floating WhatsApp lead-inquiry widget.
 *
 * NOTE: Replace WHATSAPP_NUMBER with the real business number
 * (country code + number, digits only — no '+', spaces, or dashes).
 */
const WHATSAPP_NUMBER = '919830000000';
const PREFILL = encodeURIComponent(
  "Hi Atelier Ananya! I'd like to inquire about an interior design project."
);
const waHref = `https://wa.me/${WHATSAPP_NUMBER}?text=${PREFILL}`;
---

<div id="wa-widget" class="fixed right-5 bottom-5 z-[60] flex flex-col items-end gap-3 sm:right-6 sm:bottom-6">
  <!-- Prompt bubble -->
  <div
    id="wa-bubble"
    class="pointer-events-none relative mr-1 max-w-[17rem] translate-y-2 rounded-lg rounded-br-none bg-white p-5 opacity-0 shadow-2xl transition-all duration-500"
    role="status"
  >
    <button
      id="wa-close"
      type="button"
      aria-label="Dismiss message"
      class="absolute top-2 right-2 text-stone transition hover:text-charcoal"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
    <p class="font-display text-xl font-medium text-charcoal">Have a question?</p>
    <p class="mt-1 text-sm leading-relaxed text-stone">
      Chat with our design team on WhatsApp — we usually reply within minutes.
    </p>
  </div>

  <!-- Action button -->
  <a
    href={waHref}
    target="_blank"
    rel="noopener noreferrer"
    id="wa-button"
    aria-label="Chat with Atelier Ananya on WhatsApp"
    class="relative flex h-14 w-14 items-center justify-center rounded-full bg-[#25d366] shadow-xl transition-transform duration-300 hover:scale-105 active:scale-95"
  >
    <span class="absolute inset-0 animate-ping rounded-full bg-[#25d366] opacity-30" aria-hidden="true"></span>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#ffffff" class="relative h-7 w-7" aria-hidden="true">
      <path
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
      ></path>
    </svg>
  </a>
</div>

<script>
  const bubble = document.getElementById('wa-bubble');
  const closeButton = document.getElementById('wa-close');
  const chatButton = document.getElementById('wa-button');
  const DISMISS_KEY = 'wa-bubble-dismissed';

  const hideBubble = () => {
    if (!bubble) return;
    bubble.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
  };

  const showBubble = () => {
    if (!bubble || sessionStorage.getItem(DISMISS_KEY)) return;
    bubble.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
  };

  // Nudge visitors after they've had a moment to browse.
  window.setTimeout(showBubble, 3500);

  closeButton?.addEventListener('click', () => {
    hideBubble();
    try {
      sessionStorage.setItem(DISMISS_KEY, '1');
    } catch {
      /* storage unavailable — ignore */
    }
  });

  // Opening WhatsApp implies intent; stop prompting and remember for this visit.
  chatButton?.addEventListener('click', () => {
    hideBubble();
    try {
      sessionStorage.setItem(DISMISS_KEY, '1');
    } catch {
      /* ignore */
    }
  });
</script>

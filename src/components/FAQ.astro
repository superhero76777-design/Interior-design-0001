---
import { ChevronDown } from 'lucide-astro';

const faqs = [
  {
    question: 'What is the typical budget for a full-home interior project?',
    answer:
      'Most full-home projects in Kolkata range from ₹12 lakhs for a 2BHK to ₹60 lakhs and above for large heritage homes, depending on materials, custom joinery, and scope. After a free consultation and site visit, we provide a transparent line-item estimate — no hidden costs, ever.',
  },
  {
    question: 'How long does a complete interior project take?',
    answer:
      'A typical 3BHK turnkey project takes 10–14 weeks from design freeze to handover. Heritage restorations and commercial fit-outs vary between 12–20 weeks. You receive a milestone schedule in week one, and we share weekly photo progress reports.',
  },
  {
    question: 'Do you handle everything, or do we need separate contractors?',
    answer:
      'We are fully turnkey. Civil work, electricals, plumbing, carpentry, painting, false ceilings, and final styling are all executed by our in-house teams and vetted partners — under one contract, one timeline, and one point of accountability.',
  },
  {
    question: 'Can you design according to Vastu principles?',
    answer:
      'Absolutely. Many of our Kolkata clients request Vastu-aligned planning. Our designers integrate Vastu considerations into layout, kitchen placement, and entrance design without compromising on aesthetics or functionality.',
  },
  {
    question: 'Which areas of Kolkata do you serve?',
    answer:
      'We serve the entire Kolkata metropolitan region — including Alipore, Ballygunge, Salt Lake, New Town, Behala, Howrah, and beyond. Projects outside West Bengal are considered on a case-by-case basis.',
  },
  {
    question: 'Is the initial consultation really free?',
    answer:
      'Yes. Your first consultation — including a site visit within Kolkata and a preliminary mood direction — is completely complimentary with no obligation. Use the form below to book yours.',
  },
];
---

<section id="faq" class="py-24 lg:py-32">
  <div class="mx-auto max-w-4xl px-6 lg:px-12">
    <div class="mb-14 text-center">
      <p class="reveal mb-4 text-xs font-normal tracking-[0.35em] uppercase text-crimson">FAQ</p>
      <h2 class="reveal font-display text-4xl leading-tight font-medium text-charcoal sm:text-5xl">
        Questions, <em class="italic">Answered</em>
      </h2>
      <span class="animate-line-grow mx-auto mt-6 block h-px w-24 bg-crimson" aria-hidden="true"></span>
    </div>

    <div class="divide-y divide-blush border-y border-blush">
      {
        faqs.map(({ question, answer }) => (
          <details class="group">
            <summary class="flex cursor-pointer items-center justify-between gap-6 py-6 text-left transition-colors hover:text-crimson">
              <span class="font-display text-xl font-medium text-charcoal sm:text-2xl">{question}</span>
              <span class="faq-chevron flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-blush text-crimson group-hover:border-crimson/40">
                <ChevronDown class="h-4 w-4" />
              </span>
            </summary>
            <p class="faq-answer max-w-3xl pb-7 leading-relaxed text-stone">{answer}</p>
          </details>
        ))
      }
    </div>

    <p class="reveal mt-10 text-center text-stone">
      Still curious? Call us at
      <a href="tel:+919830000000" class="font-medium text-crimson underline-offset-4 hover:underline">+91 98300 00000</a>
      — we love talking about spaces.
    </p>
  </div>
</section>

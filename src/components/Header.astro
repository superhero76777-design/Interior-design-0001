---
import { ArrowRight } from 'lucide-astro';
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-12">
    <a href="#home" class="flex items-baseline gap-2" aria-label="Atelier Ananya — home">
      <span class="font-display text-2xl font-semibold tracking-wide text-charcoal">Atelier</span>
      <span class="font-display text-2xl italic text-crimson">Ananya</span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Primary">
      {
        [
          { href: '#home', label: 'Home' },
          { href: '#about', label: 'About' },
          { href: '#services', label: 'Services' },
          { href: '#projects', label: 'Projects' },
          { href: '#transformations', label: 'Transformations' },
          { href: '#testimonials', label: 'Testimonials' },
          { href: '#faq', label: 'FAQ' },
        ].map(({ href, label }) => (
          <a
            href={href}
            class="group relative text-[13px] font-normal tracking-[0.18em] text-charcoal uppercase transition-colors hover:text-crimson"
          >
            {label}
            <span
              class="absolute -bottom-1 left-0 h-px w-0 bg-crimson transition-all duration-300 group-hover:w-full"
              aria-hidden="true"
            />
          </a>
        ))
      }
    </nav>

    <a
      href="#consultation"
      class="hidden bg-crimson px-6 py-3 text-[12px] font-normal tracking-[0.15em] uppercase text-white transition hover:bg-crimson-dark lg:inline-block"
    >
      Free Consultation
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="text-charcoal lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.25" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.25" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <nav
    id="mobile-menu"
    class="hidden border-t border-blush bg-ivory/95 backdrop-blur lg:hidden"
    aria-label="Mobile"
  >
    <div class="mx-auto max-w-7xl px-6 py-6">
      {
        [
          { href: '#home', label: 'Home' },
          { href: '#about', label: 'About' },
          { href: '#services', label: 'Services' },
          { href: '#projects', label: 'Projects' },
          { href: '#transformations', label: 'Transformations' },
          { href: '#testimonials', label: 'Testimonials' },
          { href: '#faq', label: 'FAQ' },
        ].map(({ href, label }) => (
          <a href={href} class="mobile-link block border-b border-blush py-4 font-display text-2xl text-charcoal">
            {label}
          </a>
        ))
      }
      <a
        href="#consultation"
        class="mobile-link mt-6 block bg-crimson px-6 py-4 text-center text-sm tracking-[0.15em] uppercase text-white"
      >
        Book a Free Consultation
        <ArrowRight class="ml-2 inline h-4 w-4" />
      </a>
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = () => header?.classList.toggle('is-scrolled', window.scrollY > 40);
  toggle();
  window.addEventListener('scroll', toggle, { passive: true });

  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  const setMenu = (open: boolean) => {
    if (!menuToggle || !mobileMenu || !iconOpen || !iconClose) return;
    mobileMenu.classList.toggle('hidden', !open);
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    menuToggle.setAttribute('aria-expanded', String(open));
    menuToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };

  menuToggle?.addEventListener('click', () =>
    setMenu(mobileMenu?.classList.contains('hidden') ?? false)
  );
  document.querySelectorAll('.mobile-link').forEach((link) =>
    link.addEventListener('click', () => setMenu(false))
  );
</script>
